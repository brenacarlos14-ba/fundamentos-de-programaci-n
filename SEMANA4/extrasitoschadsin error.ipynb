{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def generar_tabla(tamaño):\n",
    "    tabla = []\n",
    "    for i in range(1, tamaño + 1):\n",
    "        renglón = []\n",
    "        for j in range(1, tamaño + 1):\n",
    "            producto = sum(i for _ in range(j)) \n",
    "            renglón.append(producto)\n",
    "        tabla.append(renglón)\n",
    "    return tabla\n",
    "\n",
    "def imprimir_tabla(tabla):\n",
    "    for fila in tabla:\n",
    "        print(*fila, sep=\"\\t\")\n",
    "\n",
    "tamaño = int(input(\"tamaño de la tabla (2 a 5): \"))\n",
    "\n",
    "if 2 <= tamaño <= 5:\n",
    "    matriz = generar_tabla(tamaño)\n",
    "    imprimir_tabla(matriz)\n",
    "    \n",
    "    r = int(input(f\"renglón (1-{tamaño}): \")) - 1\n",
    "    c = int(input(f\"columna (1-{tamaño}): \")) - 1\n",
    "    print(\"producto:\", matriz[r][c])\n",
    "else:\n",
    "    print(\"error no chad: un tamaño entre 2 y 5.\")"
   ]
  }
 ],

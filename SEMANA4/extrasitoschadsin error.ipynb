{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Definición de la matriz\n",
    "matriz = [\n",
    "    [1, 2, 3], \n",
    "    [4, 5, 6], \n",
    "    [7, 8, 9], \n",
    "    [2, 4, 6]\n",
    "]\n",
    "\n",
    "# Definición de la función antes de llamarla\n",
    "def multiplicar_columna(matriz, columna):\n",
    "    producto = matriz[0][columna]\n",
    "    \n",
    "    for fila in range(1, len(matriz)):\n",
    "        siguiente_numero = matriz[fila][columna]\n",
    "        suma_acumulada = 0\n",
    "        for _ in range(siguiente_numero):\n",
    "            suma_acumulada += producto\n",
    "            \n",
    "        producto = suma_acumulada\n",
    "        \n",
    "    return producto\n",
    "\n",
    "# Entrada de usuario y validación\n",
    "columna = int(input(\"Ingresa el número de columna (0, 1 o 2): \"))\n",
    "\n",
    "if 0 <= columna <= 2:\n",
    "    resultado = multiplicar_columna(matriz, columna)\n",
    "    print(f\"El producto de la columna {columna} es: {resultado}\")\n",
    "else:\n",
    "    print(\"Número de columna fuera de rango. Debe ser 0, 1 o 2.\")"
   ]
  }
 ],

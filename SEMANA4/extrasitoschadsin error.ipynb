    "    [2, 6, 5] \n",
    "] \n",
    "suma_filas = [] \n",
    "\n",
    "def mostrar_tabla(matriz):\n",
    "    for fila in matriz:\n",
    "        for elemento in fila:\n",
    "            print(elemento, end=\" \")\n",
    "        print()\n",
    "\n",
    "for fila in matriz: \n",
    "    suma_actual = 0 \n",
    "    for numero in fila: \n",
    "        suma_actual += numero \n",
    "    suma_filas.append(suma_actual) \n",
    "\n",
    "mostrar_tabla(matriz)\n",
    "\n",
    "print(f\"Suma de la fila 1: {suma_filas[0]}\") \n",
    "print(f\"Suma de la fila 2: {suma_filas[1]}\") \n",
    "print(f\"Suma de la fila 3: {suma_filas[2]}\")"
   ]
  }

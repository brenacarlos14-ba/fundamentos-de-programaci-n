   "source": [
    "matriz = [\n",
    "    [1, 2, 3],\n",
    "    [4, 5, 6],\n",
    "    [7, 8, 9]\n",
    "]\n",
    "\n",
    "def imprimir_matriz(matriz):\n",
    "    for fila in matriz:\n",
    "        for elemento in fila:\n",
    "            print(elemento, end=\" \")\n",
    "        print()\n",
    "\n",
    "def suma_matriz(matriz):\n",
    "    total = 0\n",
    "    for fila in matriz:\n",
    "        for numero in fila:\n",
    "            total += numero\n",
    "    return total\n",
    "\n",
    "imprimir_matriz(matriz)\n",
    "print(f\"el resultado es: {suma_matriz(matriz)}\")"
   ]
  }
